# CricketWorldCup Analytics — environment template
# Copy to .env and adjust values for your local setup.
# Never commit a real .env file.

# --- Application ---
APP_ENV=development
APP_NAME=CricketWorldCup Analytics
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Project paths (relative to project root unless absolute) ---
DATA_DIR=data
CONFIG_DIR=config

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cricket_worldcup
POSTGRES_USER=cricket
POSTGRES_PASSWORD=cricket_dev_password
# Docker Compose maps container 5432 -> host 5433
DATABASE_URL=postgresql://cricket:cricket_dev_password@localhost:5433/cricket_worldcup

# --- DuckDB analytical warehouse ---
DUCKDB_PATH=data/warehouse/cricket.duckdb

# --- Collection / HTTP ---
# Conservative rate limiting (seconds between requests)
HTTP_REQUEST_DELAY_SECONDS=1.5
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=CricketWorldCupAnalytics/0.1 (educational research; local use)

# Respect robots.txt and source terms. Do not bypass access controls.
RESPECT_ROBOTS_TXT=true
ENABLE_PLAYWRIGHT=false

# --- Pipeline ---
PIPELINE_DRY_RUN=false
COLLECTION_CACHE_ENABLED=true

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501
